{
  "expo": {
    "name": "دَلّني",
    "slug": "dallni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/dallni-icon.png",
    "scheme": "dallni",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/dallni-icon.png"
    },
    "android": {
      "package": "com.dallni.marketplace",
      "adaptiveIcon": {
        "backgroundColor": "#176B5B",
        "foregroundImage": "./assets/images/dallni-android-foreground.png",
        "monochromeImage": "./assets/images/dallni-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/dallni-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F8F7",
          "image": "./assets/images/dallni-splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج دَلّني إلى الوصول إلى الصور التي تختارها لإرفاقها بطلبك.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "977280fe-78fb-416b-b34a-84be5d301c2d"
      }
    }
  }
}
