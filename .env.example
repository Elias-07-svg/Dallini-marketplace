# Copy to .env.local and fill in a hosted Supabase project URL or a local development URL.
# Use only the sb_publishable_ key in the app. Never use a secret or service_role key here.
# For a physical phone on local development, use your computer's LAN IP instead of localhost.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
